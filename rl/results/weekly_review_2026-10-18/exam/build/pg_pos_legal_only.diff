+/// True when applying the action (on a copy, with random players that are never ticked) changes either deck's size or the pilot's hand by an unseen card:
+/// a hidden draw or search. Such an action is recorded but never applied, so no hidden card enters the position.
+fn draws_hidden(st: &State, a: &Action, dm: &Deck, df: &Deck) -> bool {
+    let mut g = Game::from_state(st.clone(), players(dm, df, "r"), 1);
+    g.apply_action(a);
+    let after = g.get_state_clone();
+    let label = pg_label(a);
+    let known_draw = ["Copycat", "Sightseer", "Lisia", "Professor's Research", "Poké Ball", "Poke Ball", "Mesagoza", "Lucky Ice Pop", "Red Card", "Silver", "Pokémon Communication"]
+        .iter()
+        .any(|n| label == format!("Play:{n}"));
+    let mut grew = false;
+    for c in &after.hands[0] {
+        let id = c.get_id();
+        let n_after = after.hands[0].iter().filter(|x| x.get_id() == id).count();
+        let n_before = st.hands[0].iter().filter(|x| x.get_id() == id).count();
+        if n_after > n_before {
+            grew = true;
+        }
+    }
+    known_draw || grew || after.decks[0].cards.len() != st.decks[0].cards.len() || after.decks[1].cards.len() != st.decks[1].cards.len()
+}
+
+/// The legal actions' labels (pg_label); where two different actions carry one label (e.g. Field Blower's choice of which Tool to discard) each gets its
+/// Debug arguments appended, e.g. "DiscardToolFromPokemon{player:1,in_play_idx:0}", so a force line can name exactly one of them.
+fn legal_labels(acts: &[Action]) -> Vec<String> {
+    let base: Vec<String> = acts.iter().map(pg_label).collect();
+    (0..acts.len())
+        .map(|i| {
+            let dup = (0..acts.len()).any(|j| j != i && base[j] == base[i] && acts[j] != acts[i]);
+            if dup {
+                let dbg = format!("{:?}", acts[i].action);
+                let tail: String = dbg.find(|c: char| c == ' ' || c == '{' || c == '(').map(|k| dbg[k..].chars().filter(|c| !c.is_whitespace()).collect()).unwrap_or_default();
+                format!("{}{}", base[i], tail)
+            } else {
+                base[i].clone()
+            }
+        })
+        .collect()
+}
